<!--
  TREX low-lag patch v2 (replaces "low lag TREX"; same rbf, NMK16_Gunnail,
  and the same bjtwin.zip):
  - the gameplay loop builds the sprite list after the game logic (as v1);
  - the loop now starts at the first joystick read of the frame (IRQ1,
    line 68) instead of vblank (line 240), so the logic and the sprite list
    are done (by line ~175) before the sprite copy at line 242 of the SAME
    frame. Press to screen: about 1.3 frames on average (v1 1.9, original
    2.9). Game logic and its frame count are unchanged (it uses the line-68
    joystick read instead of the line-196 one); the
    palette upload stays in vblank. IRQ2 arms the change; if a frame ever
    misses it, IRQ4 releases the loop exactly as the original does;
  - the boot ROM checksum is kept, so it says "ROM CHECK OK" again (v1
    made it say ERROR; harmless, the game carries on either way).

  Bombjack Twin (set 1) — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 14).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... bjtwin ...)
  line 10755, ROM_START(bjtwin), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Bombjack Twin (set 1) (low lag v2 TREX)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>bjtwin</setname>
  <year>1993</year>
  <manufacturer>NMK</manufacturer>
  <category>Shooter</category>
  <rbf>NMK16_Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp. MiSTer matches this tag as TEXT, not as a
       number: mra_loader.cpp does strncasecmp(text, "vertical", 8), so the
       numeric form this file used to carry left is_vertical false and a
       tate cabinet never picked up MiSTer.ini's [arcade_vertical] section.
       The direction is explicit because MiSTer falls back to CW when none
       is given, and ROT270 turns counter-clockwise to stand upright (the
       core's own rotate_ccw=1 case). -->
  <rotation>vertical (ccw)</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,0E">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1,3" name="Starting level" ids="China,Hong_Kong,Thailand,Korea,Germany,England,Nevada,Japan"/>
    <dip bits="4,5" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8" name="Unknown (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="bjtwin.zip|nmk004.zip" md5="none" address="0x30000000">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="30ff678a" name="93087-2.bin" map="01"/>
      <part crc="93c84e2d" name="93087-1.bin" map="10"/>
    </interleave>
    <!-- NMK-215 protection MCU ROM, 0x002000 (read into the MCU from SDRAM after reset) -->
    <part crc="d355a06f" name="nmk-215.bin"/>
    <!-- fgtile, 0x010000 (8x8, the tile layer's bank-0 ROM) -->
    <part crc="aa13df7c" name="93087-3.bin"/>
    <!-- bgtile, 0x100000 (8x8, bank 1, NMK214-scrambled) -->
    <part crc="8a4f26d0" name="93087-4.bin"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_WORD_SWAP, NMK214-scrambled) -->
    <part crc="bb06245d" name="93087-5.bin"/>
    <!-- oki1, 0x100000 (NMK112-banked) -->
    <part crc="372d46dd" name="93087-6.bin"/>
    <!-- oki2, 0x100000 (NMK112-banked) -->
    <part crc="8da67808" name="93087-7.bin"/>
    <!-- TREX low lag v2: maincpu offsets, 16-bit stream words byte-swapped (low byte first) -->
    <patch offset="0x64">01 00 84 10 01 00 D4 10</patch>
    <patch offset="0x9294">00 61 F6 04 01 7E 00 FF</patch>
    <patch offset="0x929E">AC 09</patch>
    <patch offset="0x96B0">B9 4E 01 00 DE 10 71 4E 71 4E 71 4E</patch>
    <patch offset="0xCB40">00 66 54 FE 79 4A 0F 00 26 90 00 66 4A FE 00 61 3C CC</patch>
    <patch offset="0xCB54">48 C7</patch>
    <patch offset="0x11084">7C 00 00 07 E7 48 FE FF B9 4E</patch>
    <patch offset="0x11090">54 8F B9 4E</patch>
    <patch offset="0x11096">72 90 79 0C 02 00 0F 00 00 96 14 67 79 0C 01 00 0F 00 00 96 1E 66 FC 33 02 00 0F 00 00 96 14 60 FC 33 03 00 0F 00 00 96 79 52 0F 00 0E 90 79 42 0F 00 08 90 DF 4C FF 7F 7C 02 FF F8 73 4E FC 33 02 00 0F 00 00 96 73 4E 79 0C 03 00 0F 00 00 96 0C 67 79 52 0F 00 0E 90 79 42 0F 00 08 90 79 42 0F 00 00 96 75 4E</patch>
    <patch offset="0x11118">F4 4E 85 7D</patch>
  </rom>

  <!-- nmk_irq:vtiming -->
  <rom index="1" zip="bjtwin.zip|nmk004.zip" md5="none">
    <part crc="633ab1c9" name="8.ic37"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for bjtwin, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 0F 91 00 00 A0 00 4C
    </part>
  </rom>
  <nvram index="4" size="160"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 0F 90 03 00 00 09 00 00 00 00 00 00
        01 00 0F 10 6F 00 00 FF 00 00 00 00 00 00
        01 00 0F 11 6F 00 00 FF 00 00 00 00 00 00
        01 00 0F 10 37 00 00 06 00 00 00 00 00 00
        01 00 0F 11 37 00 00 06 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
