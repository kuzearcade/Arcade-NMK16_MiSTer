# MAME reference source tree — 2.8GB, kept locally as the behavioral
# reference for this port, never part of this project's own history.
/mame/

# Copyrighted arcade ROM dumps. Never committed under any circumstances.
/mame_roms/

# .mra files for sets that do not work — here rather than in releases/ so they
# are never shipped or deployed by accident, and out of git so nothing has to
# be said about them in the repository's history. One entry so far: powerinsc
# (Power Instinct USA bootleg set 3), whose sprite ROM format is undeciphered
# and which draws wrong in MAME too. tools/gen_family_c_mra.py writes it here,
# not into releases/ — see its NON_WORKING set.
/.non-working/

# ROM images reconstructed from mame_roms/ (tools/mkrom.py) are just as
# copyrighted as the zips they came from — never committed. Same caution
# applied to MAME-oracle traces (sim/oracle/traces/): a full bus trace from
# reset can indirectly reveal substantial ROM content, so these are
# regenerated locally (see docs/sim-harness.md) rather than committed,
# even though they are not literal ROM copies.
**/roms/*.hex
# Same reasoning applies to the raw ioctl-download byte streams
# tools/mk_ioctl_stream.py builds for hardware-mode testbenches (see
# docs/hw-bringup.md) — literal, undecoded ROM zip bytes.
**/roms/*.bin
sim/oracle/traces/
# MAME m6805 oracle for the M68705R3 sim (sim/rtl/m68705): a PC trace from
# reset plus the MCU's own port-read sequence — same reasoning as above, it
# is regenerated locally (see docs/tier7-tharrierb.md).
sim/rtl/m68705/roms/*.txt
# working copy the Makefile drops next to the executable for $readmemb
sim/rtl/m68705/6805.uc
sim/rtl/gunnail_mg/6805.uc
sim/rtl/*/*.trace
sim/rtl/*/*.mem
# Undocumented debug-dump artifacts the vendored jt12/jt6295 cores
# apparently emit under some simulation configurations — not source,
# not seen in any other sim/rtl/*/ build directory.
sim/rtl/*/*.raw

# fx68k's own microcode ROM tables, copied to the project root (same
# directory Quartus invokes from) so its bare $readmemb("microrom.mem")/
# $readmemb("nanorom.mem") calls resolve during synthesis — the real
# files live under the already-gitignored /rtl/third_party/fx68k/, this
# is just a build-time copy, same as every sim Makefile already does.
/microrom.mem
/nanorom.mem

# Vendored third-party cores and the MiSTer sys/ framework are fetched by
# tools/bootstrap.sh at pinned commits (see deps.lock), not committed here.
/sys/
/rtl/third_party/
/.bootstrap-staging/

# Quartus build output and scratch state
output_files/
output_files_sdramtest/
output_files_raphero/
output_files_gunnail/
output_files_nmk16_afega/
db/
incremental_db/
greybox_tmp/
# releases/ holds the hand-authored .mra files AND the current .rbf
# bitstream for each core, copied there from output_files/ after every
# build so hardware users get a matching pair without running Quartus.
/build_id.v
/jtag.cdf
sim/rtl/*/.cnxerr
sim/rtl/*/qmegawiz_errors_log.txt
# Quartus programming-tool state (quartus_pgm/System Console) generated
# alongside quartus_asm/sta runs — not source.
/cfg/
/snap/
*.qws
*.qdb
*.rpt
*.summary
*.smsg
*.sld
*.pin
*.done
*.jdi
*.htm
!docs/**/*.htm
*.qarlog
*.sopcinfo
*.qsys.orig
*_bak
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt

# Simulation artifacts
sim/**/obj_dir/
sim/**/obj_dir_*/
sim/**/obj_dir48/
# per-run logs of the multi-game harnesses (sim/rtl/gunnail_mg*)
sim/rtl/*/*.err
sim/rtl/gunnail_mg_hw/unfixed_*/
sim/**/*.vcd
sim/**/*.fst
sim/**/*.log
sim/**/oracle_traces/

# OS / editor cruft
.DS_Store
*.swp

# Frame dumps from the sim testbenches (TB_DUMP_PPM). Regenerable, and they
# pile up fast -- 12,674 of them, 3.2 GB, were cleared on 2026-09-14.
# NOTE the pattern is deliberately ONE level deep: the 85 frames in
# sim/rtl/gunnail_mg_hw/prefix_bioship/ are TRACKED, committed with 552c548
# as the evidence for the swapped sprite column-pair fix on bioship/strahl/
# acrobatm, and a `sim/**/*.ppm` rule would cover them. Keep any frames
# worth committing in a subdirectory like that one, and exclude that
# subdirectory before any bulk `find sim/rtl -name '*.ppm' -delete`.
sim/rtl/*/*.ppm
# Per-pixel scanline dumps from the TB_XDUMP probes in the tdragon2 and
# tdragon2_hw testbenches (see docs/known-issues.md NMK-21b). Multi-MB,
# regenerable from the committed instrumentation, and named freely on the
# command line -- write them as *.xdump so they stay out of git. A blanket
# *.txt rule would be wrong here: sim/rtl/powerins_*/cmp_*.txt are tracked.
sim/rtl/*/*.xdump
__pycache__/
sim/rtl/video_state/dump
# measurement run directories and build variants of the hardware sims
sim/rtl/*/obj_base/
sim/rtl/*/spr_*/
sim/rtl/*/rom_access.bin
